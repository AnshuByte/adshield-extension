{
  "manifest_version": 3,
  "name": "AdShield — Popunder & Invisible Overlay Blocker",
  "version": "1.0.0",
  "description": "Stops redirect ads, popunders and transparent click-hijack layers that send you somewhere other than the link you clicked.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "redirects", "enabled": true, "path": "rules/redirects.json" },
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": false, "path": "rules/trackers.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/main-guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/overlay-guard.js"],
      "css": ["src/content/cosmetic.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "AdShield",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
